# ─────────────────────────────────────────────────────────────────
# TamilNyaya-Bench  –  Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Groq API key  (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: comma-separated list of additional Groq API keys (fallbacks).
# When the primary key hits a 429 rate-limit, the system immediately rotates
# to the next available key instead of sleeping. Each key multiplies your
# effective throughput. Create free accounts at https://console.groq.com/
# Example: GROQ_API_KEY_FALLBACKS=gsk_key2here,gsk_key3here,gsk_key4here
GROQ_API_KEY_FALLBACKS=

# Models used at runtime. Defaults are validated against the live
# Groq list-models endpoint on startup; if a model is unavailable
# the feature that needs it is disabled with a visible message.
GROQ_MODEL_UNDER_TEST=qwen/qwen3.8-27b
GROQ_MODEL_JUDGE=openai/gpt-oss-120b
GROQ_MODEL_NLI=qwen/qwen3.8-27b

# Free-tier rate limiting (per key; total effective RPM = this × number of keys)
GROQ_REQUESTS_PER_MINUTE=30

# Annotation / calibration thresholds
KAPPA_THRESHOLD=0.6
MIN_LABELED_ITEMS_FOR_CALIBRATION=30

# Bootstrap confidence interval parameters
BOOTSTRAP_RESAMPLES=2000
BOOTSTRAP_SEED=42

# SQLite database path (relative to repo root)
DATABASE_URL=sqlite:///./data/app.db

# HTTP User-Agent sent with every outbound request
FETCHER_USER_AGENT=TamilNyaya-Bench/0.1 (research project; contact: replace@with.your.email)

# Maximum seconds to wait per HTTP request to external sources
FETCHER_TIMEOUT_SECONDS=30

# Data directory (raw downloaded files stored here)
DATA_RAW_DIR=./data/raw
